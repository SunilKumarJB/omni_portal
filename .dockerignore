# ── Version control ─────────────────────────────────────────
.git/
.gitignore

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.coverage
htmlcov/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/

# ── Node / Frontend ──────────────────────────────────────────
frontend/node_modules/
frontend/.vite/
node_modules/

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
service-account*.json
credentials*.json
gcp-key*.json
application_default_credentials.json

# ── Logs & local storage ─────────────────────────────────────
*.log
logs/
backend/storage/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Docs ─────────────────────────────────────────────────────
*.md
