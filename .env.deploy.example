# Deployment configuration for deploy-cloud-run.sh
# Copy this file to .env.deploy (gitignored) to customize defaults without modifying tracked scripts:
#   cp .env.deploy.example .env.deploy

# Target Google Cloud Project ID (defaults to active gcloud config if empty)
GCP_PROJECT_ID=

# Deployment region for Cloud Run and Artifact Registry (e.g. asia-south1, us-central1)
GCP_LOCATION=asia-south1

# Cloud Storage bucket for generated videos
GCS_BUCKET_NAME=

# Firestore database ID (leave blank for "(default)")
FIRESTORE_DATABASE_ID=

# Cloud Run runtime service account (leave blank for Compute Engine default)
SERVICE_ACCOUNT=

# Model configuration (Gemini Omni Interactions API only supports global, us, eu)
GEMINI_MODEL=gemini-omni-1.1-flash-preview
OMNI_REGION=global

# Cloud Run service names & Artifact Registry
AR_REPO=cloud-run-source-deploy
BACKEND_SERVICE=omni-video-backend
FRONTEND_SERVICE=omni-video-frontend

# Optional demo gating API key and log level
DEMO_API_KEY=
LOG_LEVEL=INFO
