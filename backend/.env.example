# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=your-gcs-bucket-name
# Local runs with user ADC cannot sign URLs. Name a service account to sign through
# the IAM API. You need roles/iam.serviceAccountTokenCreator on it; it needs
# roles/storage.objectViewer on the bucket. Leave empty on Cloud Run.
GCS_SIGNING_SERVICE_ACCOUNT=

# Gemini Enterprise Agent Platform (Interactions API) — video generation
# gemini-omni-1.1-flash-preview is the Omni video model.
# Enable the platform's API on your project, or set TEST_MODE=true below to run offline.
GEMINI_MODEL=gemini-omni-1.1-flash-preview
# REGION: model interactions region (global recommended)
REGION=global
# GEMINI_API_KEY: optional API key (if not using Google Application Default Credentials)
GEMINI_API_KEY=
# OMNI_PROJECT_ID: leave empty to reuse GCP_PROJECT_ID
OMNI_PROJECT_ID=
# OMNI_ENDPOINT_URL: optional custom endpoint URL template
OMNI_ENDPOINT_URL=
# Max seconds to wait for generation to finish (default: 600)
OMNI_MAX_WAIT_SECONDS=600
# Default video duration in seconds (1-10)
OMNI_DEFAULT_DURATION=10
# Default aspect ratio: "16:9" | "9:16"
OMNI_DEFAULT_ASPECT_RATIO=16:9

# App Configuration
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Mode (set TEST_MODE=true to use dummy placeholders without real GCP calls)
TEST_MODE=false

# Storage backend: "gcs" or "local"
STORAGE_BACKEND=local

# Database backend: "firestore" or "local"
DB_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
