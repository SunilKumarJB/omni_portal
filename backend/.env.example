# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=your-gcs-bucket-name

# Omni (Vertex AI Interactions API) — video generation
# OMNI_PROJECT_ID: leave empty to reuse GCP_PROJECT_ID
OMNI_PROJECT_ID=
OMNI_MODEL=gemini-omni-flash-preview
# OMNI_ENVIRONMENT: prod | staging | autopush
OMNI_ENVIRONMENT=prod
# OMNI_REGION: us-central1 | global
OMNI_REGION=us-central1
# OMNI_API_KEY: optional API key (if not using Google Application Default Credentials)
OMNI_API_KEY=
# OMNI_ENDPOINT_URL: optional custom endpoint URL template
OMNI_ENDPOINT_URL=
# Max seconds to wait for Omni to finish generating (default: 600)
OMNI_MAX_WAIT_SECONDS=600
# Default video duration in seconds (1-10)
OMNI_DEFAULT_DURATION=10
# Default aspect ratio: "16:9" | "9:16"
OMNI_DEFAULT_ASPECT_RATIO=16:9

# App Configuration
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Mode (set TEST_MODE=true to use dummy placeholders without real GCP calls)
TEST_MODE=false

# Storage backend: "gcs" or "local"
STORAGE_BACKEND=local

# Database backend: "firestore" or "local"
DB_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
